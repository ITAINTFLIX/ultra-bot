# MetaApi cloud token (set by the app host — enables LIVE MT5 bridge)
# Get a free/trial token: https://app.metaapi.cloud/token
# Docs: https://metaapi.cloud
#
# End users still enter THEIR OWN MT5 login/password/server in the Connect UI.
# Do not put user MT5 passwords here. Do not commit real tokens.
#
# If unset or empty, Ultra Bot runs in DEMO_SIM mode with fake gold ticks.
METAAPI_TOKEN=

# Optional: force DEMO_SIM even if token is set
# ULTRA_FORCE_DEMO=1
